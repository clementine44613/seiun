# ===== Discord Bot =====
# Your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# The Discord server (guild) ID where the bot will be used
GUILD_ID=your_discord_server_id

# The Discord channel ID where whitelist activities will be logged (optional)
LOG_CHANNEL_ID=

# ----- Roles -----
# ID of the role granted to verified players (optional)
VERIFIED_ROLE_ID=

# ID of the moderator role that can approve/deny whitelist requests (optional)
MODERATOR_ROLE_ID=

# ----- Approval -----
# The Discord channel ID where moderator approval requests will be posted.
# If this is empty, the bot will whitelist players immediately WITHOUT approval.
APPROVAL_CHANNEL_ID=

# How long an approval request stays open (in seconds). Default: 900 (15 min)
APPROVAL_TIMEOUT_SECONDS=900

# ===== Minecraft SFTP =====
# Your Shockbyte SFTP host (found in the Discord panel under SFTP Settings)
SFTP_HOST=sftp.discord.sgp2.shockbyte.host

# SFTP port (default 2222)
SFTP_PORT=2222

# Your SFTP username (e.g., default@c832bec3-...)
SFTP_USERNAME=your_sftp_username

# Your SFTP password (set this in the panel if it shows "No password set")
SFTP_PASSWORD=your_sftp_password

# IMPORTANT: use your server name as the first path segment (the "agent").
# Example for a server named "1. Meow's Island":
WHITELIST_PATH=1. Meow's Island/whitelist.json

# ===== Verification =====
# How long a verification code stays valid (in seconds). Default: 600 (10 min)
VERIFY_TIMEOUT_SECONDS=600

# ===== RCON Heartbeat (optional but recommended) =====
# RCON host (defaults to SFTP_HOST if not set)
RCON_HOST=

# RCON port (default 25575)
RCON_PORT=25575

# RCON password (set this in server.properties)
RCON_PASSWORD=

# How often the bot checks who is online (seconds). Default: 30
HEARTBEAT_INTERVAL_SECONDS=30

# How long a user can be offline from Discord verify before getting kicked (seconds). Default: 120
HEARTBEAT_TIMEOUT_SECONDS=120
</content>
